{
  "name": "@slopmachine/core",
  "version": "0.9.0",
  "description": "The official Core / VanillaJS SDK for Slop Machine",
  "llms": "https://docs.slopmachine.dev/llms.txt",
  "llmsFull": "https://docs.slopmachine.dev/llms-full.txt",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slopmachine-dev/slopmachine-sdk.git"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^17.0.4"
  },
  "license": "MIT",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false
}
