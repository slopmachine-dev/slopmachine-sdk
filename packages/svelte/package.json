{
  "name": "@slopmachine/svelte",
  "version": "0.9.0",
  "llms": "https://docs.slopmachine.dev/llms.txt",
  "llmsFull": "https://docs.slopmachine.dev/llms-full.txt",
  "description": "The official Svelte SDK for Slop Machine",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "dev": "svelte-package -i src -o dist -w",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slopmachine-dev/slopmachine-sdk.git"
  },
  "dependencies": {
    "@slopmachine/core": "^0.9.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
