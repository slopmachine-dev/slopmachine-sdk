{
  "name": "@slopmachine/react",
  "version": "0.8.1",
  "llms": "https://docs.slopmachine.dev/llms.txt",
  "llmsFull": "https://docs.slopmachine.dev/llms-full.txt",
  "description": "The official React SDK for Slop Machine",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slopmachine-dev/slopmachine-sdk.git"
  },
  "keywords": [
    "react",
    "ai",
    "slop"
  ],
  "author": "Slop Machine",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@slopmachine/core": "^0.8.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false
}
