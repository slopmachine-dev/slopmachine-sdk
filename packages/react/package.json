{
  "name": "@slopmachine/react",
  "version": "0.5.0",
  "llms": "https://docs.slopmachine.dev/llms.txt",
  "llmsFull": "https://docs.slopmachine.dev/llms-full.txt",
  "description": "The official React SDK for Slop Machine",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slopmachine-dev/slopmachine-sdk.git"
  },
  "keywords": [
    "react",
    "ai",
    "slop"
  ],
  "author": "Slop Machine",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@slopmachine/core": "^0.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/marked": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  }
