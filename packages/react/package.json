{
  "name": "@slopmachine/react",
  "version": "0.7.0",
  "llms": "https://docs.slopmachine.dev/llms.txt",
  "llmsFull": "https://docs.slopmachine.dev/llms-full.txt",
  "description": "The official React SDK for Slop Machine",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slopmachine-dev/slopmachine-sdk.git"
  },
  "keywords": [
    "react",
    "ai",
    "slop"
  ],
  "author": "Slop Machine",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@slopmachine/core": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
